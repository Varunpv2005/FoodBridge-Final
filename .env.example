# FoodBridge Configuration Template (.env.example)

# --- Security & JWT Authentication ---
FOODBRIDGE_SECRET=change-me-to-a-secure-random-secret-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Database Connection ---
# SQLite default: sqlite:///./foodbridge.db
# PostgreSQL example: postgresql://user:password@localhost:5432/foodbridge
DATABASE_URL=sqlite:///./foodbridge.db

# --- Google Maps API & Routing Integration ---
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
GOOGLE_MAPS_SERVER_API_KEY=your-google-maps-server-api-key-here
GOOGLE_MAPS_HTTP_REFERRER=http://localhost:5173/

# --- Groq Multilingual AI Assistant Integration ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=15

# --- Azure Speech Text-To-Speech (TTS) Integration ---
AZURE_SPEECH_KEY=your-azure-speech-subscription-key-here
AZURE_SPEECH_REGION=eastus
